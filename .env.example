# .env.local にコピーしてキーを入れる（.env.local はコミットしない）
#   cp .env.example .env.local
# Vercel では Project Settings → Environment Variables に GEMINI_API_KEY を登録する。
# 未設定のときは API がモック応答を返し、画面に「MOCK」と表示される。
GEMINI_API_KEY=

# ---- 計測（第10弾）----
# 解析回数の日次カウンタ（Vercel の Storage で KV / Upstash Redis を作成してプロジェクトに接続すると自動で入る）
# 無ければカウンタは何もしない（解析・画面は従来どおり動く）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# /stats?key=... を見るための合言葉（推測されにくい長い文字列）。未設定なら /stats は常に 404
STATS_TOKEN=

# ---- 課金（第11弾）：Stripe 決済リンク＋解除コード ----
# KV（上の KV_REST_API_*）も必要。どれかが無ければ課金機能は無効で、従来の「有料プランは準備中です」表示のまま動く
# 秘密鍵はサーバー専用（NEXT_PUBLIC_ を付けない）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 決済リンクの URL（未設定なら購入ボタンを出さない）。NEXT_PUBLIC_ はビルド時に埋め込まれるので、変えたら再デプロイ
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=
# 任意：カスタマーポータル（解約・支払い方法の変更）
NEXT_PUBLIC_STRIPE_PORTAL_URL=
