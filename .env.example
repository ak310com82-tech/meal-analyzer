# .env.local にコピーしてキーを入れる（.env.local はコミットしない）
#   cp .env.example .env.local
# Vercel では Project Settings → Environment Variables に GEMINI_API_KEY を登録する。
# 未設定のときは API がモック応答を返し、画面に「MOCK」と表示される。
GEMINI_API_KEY=

# ---- 計測（第10弾）----
# 解析回数の日次カウンタ（Vercel の Storage で KV / Upstash Redis を作成してプロジェクトに接続すると自動で入る）
# 無ければカウンタは何もしない（解析・画面は従来どおり動く）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# /stats?key=... を見るための合言葉（推測されにくい長い文字列）。未設定なら /stats は常に 404
STATS_TOKEN=
